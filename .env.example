# Compte Cloudflare (Workers & Pages → aperçu du compte)
CLOUDFLARE_ACCOUNT_ID=

# Jeton API avec le droit D1 Edit
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Base D1 (Workers & Pages → D1 → bob-votes → identifiant)
CLOUDFLARE_D1_DATABASE_NAME=bob-votes
# En local, cet identifiant fictif suffit. Remplace-le par l’UUID du dashboard avant un déploiement.
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-0000-0000-000000000001

# Régie locale
ADMIN_PASSWORD=bob-admin
SESSION_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bob-files
R2_PUBLIC_URL=
